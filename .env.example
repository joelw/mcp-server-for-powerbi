# MCP Server for Power BI Environment Variables
# Copy this file to .env and fill in your values

# ===== OAuth/Entra ID Configuration =====
# HTTP server port (default: 3001)
PORT=3001

# Azure AD Tenant ID
TENANT_ID=your-tenant-id-here

# Accepted audience(s) for incoming access tokens, comma-separated.
# Clients authenticate directly against the Power BI API and send that token
# here, so this is the Power BI resource rather than an app of your own.
# Both the URI and GUID forms are issued in practice, so accept both.
AUDIENCE=https://analysis.windows.net/powerbi/api,00000009-0000-0000-c000-000000000000

# ===== Optional: Required Scopes and Roles =====
# Comma-separated list of required scopes in the access token.
# These are Power BI delegated scopes (e.g. Dataset.Read.All), not scopes of
# your own app. Leave empty to accept any valid Power BI token.
REQUIRED_SCOPES=

# Comma-separated list of required roles in the access token.
# Leave empty unless the Power BI token is expected to carry app roles.
REQUIRED_ROLES=

# ===== Logging =====
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ===== Test Client Configuration (for testing OAuth flow) =====
# Client application ID for testing
TESTCLIENT_CLIENT_ID=your-test-client-id-here

# Scopes to request when testing
TESTCLIENT_SCOPE="api://your-api-app-id/mcp.access openid profile offline_access"

